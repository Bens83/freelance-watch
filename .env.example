# Copiez ce fichier en .env pour tester en local (ne jamais le committer).

# Recherche web (https://serper.dev)
SERPER_API_KEY=

# Tri IA (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-5-5

# ntfy : choisissez un nom de topic long et aléatoire, il sert de mot de passe sur ntfy.sh
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=

# Email via SMTP (exemple Gmail : smtp.gmail.com, port 587, mot de passe d'application)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=
# EMAIL_FROM=
